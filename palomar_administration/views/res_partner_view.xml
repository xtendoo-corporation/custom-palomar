<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_commercial_restrictions" model="ir.ui.view">
        <field name="name">res.partner.form.commercial.restrictions</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly">not user.has_group('palomar_administration.administrador_comerciales')</attribute>
            </xpath>
        </field>
    </record>
</odoo>

