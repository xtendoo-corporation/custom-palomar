<templates>
    <t t-name="web.CustomSignatureField">
        <t t-if="value">
            <img class="o_signature img img-fluid"
                 alt="Binary file"
                 t-att-src="getUrl"
            />

        </t>
        <t t-else="">
            <div class="o_signature o_signature_empty" t-att-style="sizeStyle" t-on-click="onClickSignature">
                <svg t-on-error.stop="onLoadFailed"></svg>
                <p>SIGNATURE</p>
            </div>
        </t>
    </t>
</templates>
